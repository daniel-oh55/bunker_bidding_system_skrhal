{
  "name": "skrhal-bunker-bidding",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint src vite.config.ts",
    "test": "vitest",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "check:foundation": "node scripts/check-foundation-boundaries.mjs",
    "db:start": "supabase start",
    "db:reset": "supabase db reset --local",
    "db:test": "supabase test db --local supabase/tests/database",
    "db:test:concurrency": "node scripts/test-membership-concurrency.mjs",
    "db:test:bid-concurrency": "node scripts/test-bid-concurrency.mjs",
    "db:test:mail-concurrency": "node scripts/test-mail-intake-concurrency.mjs",
    "auth:test:integration": "node scripts/test-frontend-auth-access.mjs",
    "db:test:quote-concurrency": "node scripts/test-quote-concurrency.mjs",
    "quote:test:integration": "node scripts/test-trader-quote-integration.mjs",
    "realtime:test:integration": "node scripts/test-realtime-workspace-notifications.mjs",
    "db:stop": "supabase stop --no-backup",
    "preview": "vite preview"
  },
  "dependencies": {
    "@kenjiuno/msgreader-web-ng": "0.2.0-alpha1",
    "@supabase/supabase-js": "^2.57.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.3.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "pg": "8.22.0",
    "supabase": "2.110.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  }
}
